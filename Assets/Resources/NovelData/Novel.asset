    text: "\u3093\u306B\u3083\u3074"
    speed: 20
    characterImage: {fileID: 21300000, guid: c9531721ec7a9324e825606fa8ac5d6c, type: 3}
  - caption: "\uFF1F\uFF1F\uFF1F"
    text: "\u3053\u308C\u306F\u30C6\u30B9\u30C8\u753B\u9762\u3067\u3042\u308B\u305E"
    speed: 20
    characterImage: {fileID: 21300000, guid: 50ec54f42259dde4ba2227f88733657e, type: 3}
  - caption: "\uFF1F\uFF1F\uFF1F"
    text: "\u304A\u305D\u304F\u51FA\u529B\u3082\u3067\u304D\u308B\u3079"
    speed: 20
    characterImage: {fileID: 21300000, guid: 50ec54f42259dde4ba2227f88733657e, type: 3}
  - caption: "\uFF1F\uFF1F\uFF1F"
    text: "\u3057\u3083\u3079\u3089\u305B\u308B\u7ACB\u3061\u7D75\u306E\u4F4D\u7F6E\u3068\u304B\u3082\n\u8ABF\u6574\u51FA\u6765\u305F\u3089\u3044\u3044\u3088\u306D\u3093"
    speed: 20
    characterImage: {fileID: 21300000, guid: 2ff04f087c185ae40b196395e450441d, type: 3}
  - caption: "\uFF1F\uFF1F\uFF1F"
    text: "\u672C\u5F53\u306A\u3089\u3080\u3061\u3083\u304F\u3061\u3083\u901F\u304F\u3057\u3083\u3079\u3089\u305B\u3066\n\u30AA\u30BF\u30AF\u3057\u3083\u3079\u308A\u307F\u305F\u3044\u306B\u3057\u3066\u307F\u305F\u304B\u3063\u305F\u308A\u306F\u3059\u308B\u3051\u3069\n\u306D\u3068\u79C1\u306F\u601D\u3046\u308F\u3051\u3067\u3059\u304C"
    speed: 40
    characterImage: {fileID: 21300000, guid: 2ff04f087c185ae40b196395e450441d, type: 3}
  - caption: "\uFF1F\uFF1F\uFF1F"
    text: "\u5165\u308B\u6587\u5B57\u6570\u306F\u3053\u3093\u306A\u3082\u3093\u3002\n\u3044\u308C\u3088\u3046\u3068\u601D\u3048\u3070\u7121\u9650\u306B\u5165\u308B\u3068\u306F\u601D\u3046\u304C\u3001\n\uFF14\u884C\u4EE5\u4E0A\u306F\u78BA\u5B9F\u306B\u67A0\u304B\u3089\u6EA2\u308C\u3066\u3057\u307E\u3046\u306A\u3002\n\u3067\u3082\u3063\u3066\u3053\u308C\u304C\u591A\u5206\u6700\u5927\u5BB9\u91CF\u3060\u3068\u601D\u3046\u3093\u3060\u305C\u30D6\u30E9\u30B6\u30FC\u3002\n(\u591A\u5206\u3053\u3053\u304B\u3089\u3042\u3075\u308C\u3066\u308B\u3068\u304A\u3082\u3046\u3079)"
    speed: 40
    characterImage: {fileID: 21300000, guid: 2ff04f087c185ae40b196395e450441d, type: 3}
