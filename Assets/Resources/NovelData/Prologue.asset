  m_Script: {fileID: 11500000, guid: 6cf810a9463ca224a8c2cb1c07280411, type: 3}
  m_Name: Prologue
  m_EditorClassIdentifier: 
  messages:
  - caption: 
    messageType: 1
    text: "\u3053\u3053\u306F\u3001\u4EBA\u3068\u4EBA\u306A\u3089\u3056\u308B\u8005\u9054\u304C\u66AE\u3089\u3059\u4E16\u754C\u3002"
    speed: 20
    characterImage: {fileID: 0}
    secondCharacterImage: {fileID: 0}
    backgroundImage: {fileID: 0}
    choices: []
    sceneName: 
  - caption: 
    messageType: 1
    text: "\u3053\u306E\u4E16\u754C\u3067\u306F\u3001\u4EBA\u9593\u3067\u306F\u306A\u3044\u8005\u305F\u3061\u2015\u2015\n\u3044\u308F\u3086\u308B\u4E9C\u4EBA\u3092\u3001\u7DCF\u3058\u3066\u300C\u9B54\u65CF\u300D\u3068\u547C\u3093\u3067\u3044\u308B\u3002"
    speed: 20
    characterImage: {fileID: 0}
    secondCharacterImage: {fileID: 0}
    backgroundImage: {fileID: 0}
    choices: []
    sceneName: 
  - caption: 
    messageType: 1
    text: "\u305D\u3057\u3066\u5F7C\u3089\u306E\u591A\u304F\u306F\u3001\u9B54\u6CD5\u3092\u5B66\u3076\u305F\u3081\u3001\n\u4E00\u3064\u306E\u5B66\u5712\u3078\u3068\u901A\u3063\u3066\u3044\u308B\u3002"
    speed: 20
    characterImage: {fileID: 0}
    secondCharacterImage: {fileID: 0}
    backgroundImage: {fileID: 0}
    choices: []
    sceneName: 
  - caption: 
    messageType: 1
    text: "\u305D\u3093\u306A\u60AA\u9B54\u305F\u3061\u304C\u66AE\u3089\u3059\u3053\u306E\u4E16\u754C\u306B\u306F\n\u53E4\u304F\u304B\u3089\u8A9E\u308A\u7D99\u304C\u308C\u3066\u3044\u308B\u3001\u4E00\u3064\u306E\u304A\u3068\u304E\u8A71\u304C\u3042\u3063\u305F\u3002"
    speed: 20
    characterImage: {fileID: 0}
    secondCharacterImage: {fileID: 0}
    backgroundImage: {fileID: 0}
    choices: []
    sceneName: 
  - caption: 
    messageType: 1
    text: "\u2015\u2015\u9B54\u65CF\u304C\u4EBA\u9593\u3068\u604B\u306B\u843D\u3061\u305F\u3068\u304D\u3001\n\u3000\u3000\u3000\u305D\u306E\u8005\u306E\u9B54\u529B\u306F\u98DB\u8E8D\u7684\u306B\u9AD8\u307E\u308B\u3002"
    speed: 20
    characterImage: {fileID: 0}
    secondCharacterImage: {fileID: 0}
    backgroundImage: {fileID: 0}
    choices: []
    sceneName: 
  - caption: 
    messageType: 1
    text: "\u3053\u306E\u4E16\u754C\u306B\u304A\u3044\u3066\u9B54\u529B\u3068\u306F\u3001\u4F55\u3088\u308A\u3082\u5927\u304D\u306A\u4FA1\u5024\u3092\u6301\u3064\u3002"
    speed: 20
    characterImage: {fileID: 0}
    secondCharacterImage: {fileID: 0}
    backgroundImage: {fileID: 0}
    choices: []
    sceneName: 
  - caption: 
    messageType: 1
    text: "\u9B54\u529B\u3092\u591A\u304F\u6301\u3064\u8005\u306F\u5BCC\u3084\u540D\u8A89\u3092\u624B\u306B\u3057\u3001\n\u53CD\u5BFE\u306B\u9B54\u529B\u3092\u6301\u305F\u306A\u3044\u8005\u306F\u51B7\u9047\u3055\u308C\u308B\u3002"
    speed: 20
    characterImage: {fileID: 0}
    secondCharacterImage: {fileID: 0}
    backgroundImage: {fileID: 0}
    choices: []
    sceneName: 
  - caption: 
    messageType: 1
    text: "\u529B\u3053\u305D\u304C\u3082\u306E\u3092\u8A00\u3046\u3001\u5F31\u8089\u5F37\u98DF\u306E\u4E16\u754C\u3002"
    speed: 20
    characterImage: {fileID: 0}
    secondCharacterImage: {fileID: 0}
    backgroundImage: {fileID: 0}
    choices: []
    sceneName: 
  - caption: 
    messageType: 1
    text: "\u3060\u304B\u3089\u3053\u305D\u3001\u9B54\u65CF\u305F\u3061\u306F\u7686\u3001\n\u81EA\u3089\u306E\u9B54\u529B\u3092\u9AD8\u3081\u308B\u305F\u3081\u306B\u65E5\u3005\u5FC3\u8840\u3092\u6CE8\u3044\u3067\u3044\u305F\u3002"
    speed: 20
    characterImage: {fileID: 0}
    secondCharacterImage: {fileID: 0}
    backgroundImage: {fileID: 0}
    choices: []
    sceneName: 
  - caption: 
    messageType: 1
    text: "\u305D\u3093\u306A\u9B54\u65CF\u305F\u3061\u304C\u96C6\u3046\u5B66\u5712\u306B\u3001\n\u3042\u308B\u65E5\u3001\u4E00\u4EBA\u306E\u4EBA\u9593\u304C\u73FE\u308C\u305F\u3002"
    speed: 20
    characterImage: {fileID: 0}
    secondCharacterImage: {fileID: 0}
    backgroundImage: {fileID: 0}
    choices: []
    sceneName: 
  - caption: 
    messageType: 1
    text: "\u4EBA\u9593\u3068\u604B\u3092\u3059\u308C\u3070\u3001\u9B54\u529B\u304C\u4E0A\u304C\u308B\u3002"
    speed: 20
    characterImage: {fileID: 0}
    secondCharacterImage: {fileID: 0}
    backgroundImage: {fileID: 0}
    choices: []
    sceneName: 
  - caption: 
    messageType: 1
    text: "\u305D\u3093\u306A\u304A\u3068\u304E\u8A71\u3092\u4FE1\u3058\u308B\u9B54\u65CF\u305F\u3061\u306B\u3068\u3063\u3066\u3001\n\u305D\u306E\u4EBA\u7269\u306E\u5B58\u5728\u306F\u3042\u307E\u308A\u306B\u3082\u9B45\u529B\u7684\u3060\u3063\u305F\u3002"
    speed: 20
    characterImage: {fileID: 0}
    secondCharacterImage: {fileID: 0}
    backgroundImage: {fileID: 0}
    choices: []
    sceneName: 
  - caption: 
    messageType: 1
    text: "\u305D\u3057\u3066\u3042\u308B\u65E5\u3002\r\n\u305D\u306E\u5F7C\u304C\u3064\u3044\u306B\u3001\u60F3\u3044\u4EBA\u3078\u544A\u767D\u3059\u308B\u3064\u3082\u308A\u3089\u3057\u3044\u3002"
    speed: 20
    characterImage: {fileID: 0}
    secondCharacterImage: {fileID: 0}
    backgroundImage: {fileID: 0}
    choices: []
    sceneName: 
  - caption: 
    messageType: 1
    text: "\u305D\u306E\u3088\u3046\u306A\u3046\u308F\u3055\u304C\u3001\u5B66\u5712\u4E2D\u3092\u99C6\u3051\u5DE1\u308B\u3002\r\n\u305D\u308C\u3092\u77E5\u3063\u305F\u9B54\u65CF\u305F\u3061\u306F\u601D\u3063\u305F\u3002"
    speed: 20
    characterImage: {fileID: 0}
    secondCharacterImage: {fileID: 0}
    backgroundImage: {fileID: 0}
    choices: []
    sceneName: 
  - caption: 
    messageType: 1
    text: "\u2015\u2015\u3053\u308C\u304C\u3001\u6700\u5F8C\u306E\u30C1\u30E3\u30F3\u30B9\u3060\u3002"
    speed: 20
    characterImage: {fileID: 0}
    secondCharacterImage: {fileID: 0}
    backgroundImage: {fileID: 0}
    choices: []
    sceneName: 
  - caption: 
    messageType: 1
    text: "\u5F53\u65E5\u3001\u5F7C\u306F\u3001\u60F3\u3044\u4EBA\u306E\u3082\u3068\u3078\u5411\u304B\u3046\u3002"
    speed: 20
    characterImage: {fileID: 0}
    secondCharacterImage: {fileID: 0}
    backgroundImage: {fileID: 0}
    choices: []
    sceneName: 
  - caption: 
    messageType: 1
    text: "\u3060\u304C\u3001\u305D\u306E\u9053\u306E\u5148\u306B\u5F85\u3063\u3066\u3044\u308B\u306E\u306F\u3001\n\u544A\u767D\u3092\u963B\u3082\u3046\u3068\u3059\u308B\u6570\u591A\u306E\u9B54\u65CF\u305F\u3061\u3002"
    speed: 20
    characterImage: {fileID: 0}
    secondCharacterImage: {fileID: 0}
    backgroundImage: {fileID: 0}
    choices: []
    sceneName: 
  - caption: 
    messageType: 1
    text: "\u3053\u308C\u306F\u3001\u4E00\u4EBA\u306E\u4EBA\u9593\u304C\u60F3\u3044\u4EBA\u306B\u6C17\u6301\u3061\u3092\u4F1D\u3048\u308B\u305F\u3081\u3001\r\n\u6B21\u3005\u3068\u8FEB\u308A\u6765\u308B\u300C\u544A\u767D\u300D\u3068\u3044\u3046\u540D\u306E\u59A8\u5BB3\u3092\u632F\u308A\u5207\u308A\u3001\n\u4E57\u308A\u8D8A\u3048\u3066\u3044\u304F\u304A\u8A71\u3067\u3042\u308B\u3002"
    speed: 20
